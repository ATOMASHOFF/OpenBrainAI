{
  "manifest_version": 3,
  "name": "OpenBrainAI",
  "version": "1.0.0",
  "description": "A floating assistant that answers questions about anything on your screen, powered by Claude.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenBrainAI settings"
  }
}